# Isosha Esosheni — configuration reference.
#
# This app does NOT read .env files at runtime. Values are injected at
# COMPILE TIME via --dart-define. This file exists purely as documentation
# of the required defines (and is whitelisted in .gitignore for that reason).
#
# Usage:
#   flutter run \
#     --dart-define=SUPABASE_URL=<your-project-url> \
#     --dart-define=SUPABASE_ANON_KEY=<anon key> \
#     --dart-define=WEB_BASE_URL=https://isosha-esosheni-two.vercel.app
#
# Omit all three to run against the built-in offline demo backend.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
WEB_BASE_URL=https://isosha-esosheni-two.vercel.app

# NEVER put a service_role key here or anywhere in this repository.
